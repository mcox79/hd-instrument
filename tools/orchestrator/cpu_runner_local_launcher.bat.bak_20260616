@echo off
REM Launcher batch for cpu_runner_local on FrameworkMPC, called by Windows Task Scheduler.
REM Task Scheduler will own the process; it survives session disconnect.
REM
REM 90% CPU CAP: this laptop has 12 physical / 16 logical cores.
REM OMP_NUM_THREADS=10 = 83% of physical / 62% of logical -- caps each
REM experiment's inner-loop parallelism. Combined with /BELOWNORMAL priority
REM and the runner's BELOW_NORMAL_PRIORITY_CLASS for children, no single
REM experiment can saturate the machine.
SET OMP_NUM_THREADS=10
SET MKL_NUM_THREADS=10
SET OPENBLAS_NUM_THREADS=10
SET NUMEXPR_NUM_THREADS=10
SET TORCH_NUM_THREADS=10
REM
REM -X utf8 keeps PYTHONIOENCODING=utf-8 active (no cp1252 crashes).
REM /BELOWNORMAL caps runner + child priority so the laptop stays usable.
REM SINGLETON LOCK: handled by runner_v2_prod.py PID-file guard.
start "cpu_runner_local" /BELOWNORMAL /WAIT "D:\AI\hd-instrument\.venv\Scripts\python.exe" -X utf8 "D:\AI\hd-instrument\experiments\runner_v2_prod.py" --queue-dir "D:\AI\hd-instrument\data\local_cpu_queue" --id cpu_runner_local --idle-exit-minutes 480 --singleton-pid-file "D:\AI\hd-instrument\data\logs\cpu_runner_local.pid" >> "D:\AI\hd-instrument\data\logs\cpu_runner_local.log" 2>&1
