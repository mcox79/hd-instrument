{
  "_meta": {
    "name": "resulting_state_entailment_gold_v1",
    "purpose": "Resulting-state entailment gold: each sentence labeled with the entailed RESULTING STATE of the affected entity. Extends who-is-affected (patient) with a NEW label = the state the entity ends up in. First composition/reasoning brick above lexical lookup.",
    "annotator": "director-single-annotator (illustrative; McGuffey-register simple SVO). Same single-annotator caveat as mcguffey_whoaffected_oracle_gold_v2_heldout.",
    "label_taxonomy": {
      "not_intact": "physical integrity destroyed/degraded (break/crack/tear/burn/smash). VerbNet result-pred family: degradation_material_integrity, apart, physical_form.",
      "changed_state": "reversible/qualitative state change, not creation/destruction (open/shut/close/fix/boil/dry/feed). VerbNet: state, cooked, apply_heat, together.",
      "created": "entity now exists (build/make/knit/write/draw). VerbNet: exist, created_image, made_of, designated. affectedness_type effected.",
      "possession_changed": "ownership/holding transferred (give/sell/catch/lose/get/send). VerbNet: has_possession, transfer. affectedness_type transfer.",
      "new_location": "physical position changed (put/move/roll/set/carry). VerbNet: motion, location. affectedness_type motion.",
      "unchanged": "entity NOT affected: perception (see/look/hear), cognition (think/like), stative possession (have/is), encounter (meet), pursuit (hunt), OR any negated verb. affectedness_type cognition/perception/possession OR negation."
    },
    "wsd_ambiguous_flag": "items with ambiguous=true carry a verb whose MODAL VerbNet sense mismatches the sentence sense (burn=glow, write=lecture, draw=pull, get=convert, send=confine, set=impress, carry=cost). These are EXPECTED honest misses -> confirm word-sense-disambiguation is the next gap; they keep the system non-saturated.",
    "note": "Authored + McGuffey-register. Verb tokens surface-form; affected = patient span; result_state = the NEW entailment label. LOCAL-only eval asset; NO push/persist."
  },
  "gold": [
