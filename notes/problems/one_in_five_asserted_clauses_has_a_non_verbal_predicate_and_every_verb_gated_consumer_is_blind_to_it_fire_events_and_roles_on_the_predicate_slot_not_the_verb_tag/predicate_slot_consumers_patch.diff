+    def _add_copular_predicate_events(self, events, toks, up):
+        """Fire the STATE-event of a NON-VERBAL predication on the copula's COMPLEMENT (the property/class/
+        location/possession).  cop_predicates already returns the complement ONLY when the copula has no verbal
+        host in its own verb group, so this fires exactly on the clauses the VERB gate misses.  is_state=True
+        marks the neo-Davidsonian STATE so it is ONE structure with the copular state reader, not two.
+        Default-OFF via nonverbal_predicate_events until landed (no-default-off applies at landing)."""
+        if not getattr(self, "nonverbal_predicate_events", False):
+            return events
+        from hdlab.attachment_arm import cop_predicates
+        have = set(e.idx for e in events)
