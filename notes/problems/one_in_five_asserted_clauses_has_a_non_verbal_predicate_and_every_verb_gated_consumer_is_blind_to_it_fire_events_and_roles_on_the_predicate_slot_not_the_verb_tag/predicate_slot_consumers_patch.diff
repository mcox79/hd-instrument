+            if 0 <= q - 1 < len(toks) and (q - 1) not in have:
+                ev = T.Event(lemma=toks[q - 1].lower(), idx=q - 1, pos=up[q - 1],
+                             tense=T.TENSE_SIMPLE_PAST, is_pp=False)
+                setattr(ev, "is_state", True)
