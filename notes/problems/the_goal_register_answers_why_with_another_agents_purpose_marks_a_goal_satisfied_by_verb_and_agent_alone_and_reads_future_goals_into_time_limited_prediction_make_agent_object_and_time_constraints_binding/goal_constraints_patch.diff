+    if base is None or base < 0:
+        base = getattr(g, "verb_tok", -1)
+    if base is None or base < 0:
+        return 10 ** 6                      # no position known -> no same-sentence outcome can be ordered
+    n = len([t for t in str(getattr(g, "goal_text", "") or "").split() if t])
+    return base + max(1, n)
+
