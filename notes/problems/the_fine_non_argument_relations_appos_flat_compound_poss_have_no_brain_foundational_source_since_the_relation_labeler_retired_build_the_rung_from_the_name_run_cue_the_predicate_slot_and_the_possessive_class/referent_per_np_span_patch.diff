+# ===============================================================================================================
+# THE NP SPAN AND THE GLOBAL TOKEN INDEX (pri 134 phase 7, 2026-09-16).
+#
+# THE DEFECT.  Every mention this organ makes carries `gtok_start = gtok_end = -1` and a ONE-TOKEN,
+# LOWERCASED `span_toks`.  The mention schema this stream claims to implement (`coref.parse_litbank_conll`,
+# documented at coref.py:167) is: `wtok_start` = the SPAN START, `span_toks` = the RAW-CASED span with the
+# HEAD LAST, `gtok_start..gtok_end` = the span's global extent.  A one-token span satisfies that schema only
+# degenerately -- start == head, extent == 0 -- so the violation is invisible until a consumer asks for the
+# extent, and then it abstains or reads a point.  MEASURED consequences on the LIVE default read:
+#   * `crosstype_live_adapter._can_build` rejects 292 of 292 non-pronoun mentions on a GUM document, so the
+#     default-ON crosstype bridge returns its input unchanged on EVERY raw-text read and its predication
+#     detector is never entered (0 of 6 documents, 0 edges).
+#   * `lexical_utils.definiteness` reads the span's FIRST token, which is the head, so it answers "bare" on
+#     100% of mentions -- the definite/indefinite distinction the whole Heim file-change account rests on.
+#   * `lexical_utils.modifiers` is empty by construction (`span[:-1]` of a one-token span).
+#   * `coref.mention_span` returns a POINT, so a pick can only ever align on the head token.
+#   * pri 118's span-level NAME-RUN cue -- the lever that carries its whole +0.0103 -- is inert here, as pri
+#     118's own docstring says: "it is INERT here because this builder stores span_toks=[head]".
+#
+# THE BRAIN.  A referring expression is ONE unit: the determiner phrase is segmented as a chunk and retrieved
+# as a chunk (Heim 1982 file cards are opened by a DP, not by a noun; Kripke 1980 / Semenza 2006 for the name
+# run as a single stored item).  The chunk is read off the category sequence -- determiner, modifiers, head --
+# with no arc needed, which is why it is available at this rung at all.  `heads_fn` is the optional hook for
+# the arc-based projection (the attachment arm's dependents of the head) once a caller can supply heads with
+# no second parse; with none the arc-free chunk stands, and it is what is measured.
+#
+# WHAT CHANGES, EXACTLY, AND THE ONE THING THAT COSTS SOMETHING: this emits the CANONICAL schema, so
+# `wtok_start` moves from the HEAD position to the SPAN START.  That is the field the positional word-order
+# cue reads (`graded_role_assigner.agent_supports`, `situation_reader`'s pre/post-verb splits), so the
+# agent / patient rows can move; the number is in the pri-134 SOLVED and the switch below reverts exactly
+# this block.  `head` stays the lowercased head lemma and `span_toks[-1]` is that head, so every consumer
+# that reads the head is byte-identical.
+# ===============================================================================================================
+RPN_SPAN = os.environ.get("HDLAB_RPN_SPAN", "1") == "1"
+# NP-internal categories the chunk may absorb to the LEFT of its head.  A verb / adposition / conjunction /
+# punctuation closes the chunk, which is the same domain boundary `coref._np_domain` and the attachment arm's
+# NP_SPLIT cue already use.
+_NP_LEFT = ("DET", "ADJ", "NUM", "NOUN", "PROPN", "PART", "PRON", "SYM", "X", "ADV")
+_NP_LEFT_MAX = 8
+
+
+def _np_chunk_start(toks, up, hw, heads_fn=None):
+    """The LEFT EDGE of the referring expression headed by 0-based `hw` -- determiner + modifiers + any
+    name-run / compound members, read off the category sequence.  `heads_fn` (optional) returns 1-based
+    heads for this sentence; when supplied, the chunk is intersected with the head's own arc projection so a
+    modifier the governor attached elsewhere is not absorbed."""
+    a = hw
+    steps = 0
+    while a - 1 >= 0 and steps < _NP_LEFT_MAX:
+        u = up[a - 1] if a - 1 < len(up) else "X"
+        if u not in _NP_LEFT:
+            break
+        if u == "ADV":                       # an adverb only continues the chunk before an adjective
+            if not (a - 2 >= 0 and a < len(up) and up[a] == "ADJ"):
+                break
+        if u == "PRON":                      # a pronoun continues it only in determiner position (possessive)
+            if str(toks[a - 1]).lower() not in _POSS_DET:
+                break
+        a -= 1
+        steps += 1
+    if heads_fn is not None:
+        try:
+            hd = heads_fn()                  # 1-based child -> head; keep only tokens whose path reaches hw
+            if hd:
+                keep = a
+                for k in range(a, hw):
+                    j, depth = k + 1, 0
+                    while j and depth < 6:
+                        if j - 1 == hw:
+                            break
+                        j = int(hd.get(j, 0) or 0)
+                        depth += 1
+                    else:
+                        keep = k + 1
+                        continue
+                    if j - 1 != hw:
+                        keep = k + 1
+                a = keep
+        except Exception:
+            pass
+    return a
+
+
+_POSS_DET = frozenset({"my", "your", "his", "her", "its", "our", "their", "whose"})
