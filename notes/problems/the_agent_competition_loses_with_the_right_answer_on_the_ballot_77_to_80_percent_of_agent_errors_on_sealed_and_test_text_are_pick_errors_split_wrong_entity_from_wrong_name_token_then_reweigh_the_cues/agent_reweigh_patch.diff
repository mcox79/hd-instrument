+# =====================================================================================
+# pri 140 -- THE AGENT CUE VALIDITIES, ACCRUED FROM READING (the re-weighed competition)
+# =====================================================================================
+# The AGENT weights above (`AGENT_VALIDITIES`) are HAND-SET, and the Competition Model says a
+# cue's weight IS its validity -- availability x reliability, accrued from exposure (MacWhinney,
+# Bates & Kliegl 1984).  This block is that accrual, in the SAME form the coarse role table
+# already uses (`strengths_from_counts`): counts in, log-odds contrasts out, one online observe
+# path, no fit.  It is self-gating: with no asset on disk `agent_validities()` returns None and
+# `agent_competition_pick_conf` is byte-identical to the landed competition.
+_AGENT_VALIDITIES_PATH = os.environ.get("HDLAB_AGENT_VALIDITIES") or os.path.join(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data", "frontend_assets",
+    "agent_cue_validities_ud_ewt_v1.json")
