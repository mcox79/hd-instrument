+def supply_global_indices(role_mentions, sents):
+    """THE MISSING JOIN (pri 136).  This adapter needs a GLOBAL token index on every non-pronoun mention;
+    since pri 125 made `referent_per_np` the reader's mention source those indices are -1 on every mention,
+    so `_can_build` abstained and the definite->name BRIDGE -- DE-LEAK PART 2, the organ that recovered the
+    +0.0838 CI-sep experiencer gain -- returned ZERO binds on every live read (measured: 0 binds on 12 of 12
+    GUM documents).  The index is fully determined by what the mention already carries:
+        gtok = sum(len(s) for s in sents[:sent_idx]) + wtok_start
+    (the same running count `_build_toks` uses).  Returns a NEW list; the caller's mentions are never
+    mutated.  A mention that already carries a valid index is left exactly as it is."""
+    offs, total = [], 0
+    for s in sents:
+        offs.append(total)
+        total += len(s)
