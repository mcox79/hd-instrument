+    gs, ge = m.get("gtok_start", -1), m.get("gtok_end", -1)
+    span = 0
+    if isinstance(gs, int) and isinstance(ge, int) and gs >= 0 and ge >= gs:
+        span = ge - gs
+    elif m.get("span_toks"):
+        span = max(0, len(m["span_toks"]) - 1)
+    return (int(m.get("sent_idx", -1)), ws, ws + span)
