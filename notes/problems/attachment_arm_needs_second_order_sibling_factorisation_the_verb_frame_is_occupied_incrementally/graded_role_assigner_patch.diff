# Add to hdlab/graded_role_assigner.py, mirroring observe_role_outcome: when a verb's argument frame is
# understood (its confirmed set of core fillers), bump n1/n2 for each occupied slot and re-derive lambda.
#
+def observe_frame_outcome(slot_counts_per_verb, table=None):
+    """PLASTICITY: accrue one comprehension outcome -- {slot: n_fillers} for a understood verb frame --
+    into the slot-capacity counts. n1 += 1 per slot with >=1 filler; n2 += 1 per slot with >=2. lambda is
+    then a pure function of the counts (see _slot_capacity). Persist with save_coarse_validities()."""
+    tab = table or load_coarse_validities()
+    sc = tab.setdefault("slot_capacity", {s: [0, 0] for s in CORE_SLOTS})
+    for slot, n in slot_counts_per_verb.items():
+        if slot in sc:
+            sc[slot][0] += 1
+            if n >= 2:
+                sc[slot][1] += 1

