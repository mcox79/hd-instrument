+def np_groups(toks, up, head_wpos, gov=None, head_post=None, mode=None):
+    """ONE REFERENT PER NP.  Group this sentence's content-noun heads into noun phrases and return
+    {surviving_head: (span_start, surviving_head, [absorbed head positions])}.
+
+    The Right-Hand Head Rule decides which head survives: a content head that lies inside a LATER head's
+    phrase is a MEMBER of that phrase (a compound modifier, a name run, a possessor's noun), so it does not
+    open a discourse referent of its own.  `RPN_COLLAPSE=0` keeps one referent per token (spans only), for
+    the A/B that separates the span repair from the collapse."""
+    hs = sorted({int(x) for x in (head_wpos or ())})
+    if not hs:
+        return {}
+    edge = {h: np_left_edge(toks, up, h, gov, head_post, mode) for h in hs}
+    parent = {}
+    if RPN_COLLAPSE:
+        for i, h in enumerate(hs):
+            for h2 in hs[i + 1:]:
+                if edge[h2] <= h < h2:
+                    parent[h] = h2
+                    break
+    root = {}
+    for h in hs:
+        r, seen = h, set()
+        while r in parent and r not in seen:
+            seen.add(r)
+            r = parent[r]
+        root[h] = r
+    out = {}
+    for h in hs:
+        r = root[h]
+        if r not in out:
+            out[r] = [edge[r], r, []]
+        if h != r:
+            out[r][0] = min(out[r][0], edge[h])
+            out[r][2].append(h)
+    return {r: (v[0], v[1], sorted(v[2])) for r, v in out.items()}
+
