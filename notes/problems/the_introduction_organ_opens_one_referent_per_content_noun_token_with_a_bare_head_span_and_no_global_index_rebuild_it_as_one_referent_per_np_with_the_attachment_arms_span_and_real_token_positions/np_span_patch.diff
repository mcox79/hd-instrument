+def _np_cat_admissible(toks, up, k) -> bool:
+    """Is token `k` NP-INTERNAL MATERIAL by category?  (The category organ's own decision; arc-free.)"""
+    u = up[k] if k < len(up) else "X"
+    if u not in _NP_LEFT:
+        return False
+    if u == "ADV":                       # an adverb continues the phrase only as a degree word on an adjective
+        return (k + 1 < len(up) and up[k + 1] == "ADJ")
+    if u == "PRON":                      # a pronoun continues it only in determiner position (a possessive)
+        return str(toks[k]).lower() in _POSS_DET
+    return True
+
+
+def _np_closes_left(toks, up, k) -> bool:
+    """Does absorbing `k` close the phrase's left edge?  A determiner / possessive is the DP's outermost
+    layer (Abney 1991), so nothing to its left is in THIS phrase."""
+    u = up[k] if k < len(up) else "X"
+    w = str(toks[k]).lower()
+    return (u in _CLOSES_LEFT) or (u == "PRON" and w in _POSS_DET) or w.endswith("'s") or w == "'s"
+
+
+def _arc_reaches(gov, k: int, h: int, maxdepth: int = 8) -> bool:
+    """Does the attachment arm's arc path from 0-based `k` reach the head `h` without leaving its left side?"""
+    j = k
+    for _ in range(maxdepth):
+        j = int(gov.get(j, -1))
+        if j == h:
+            return True
+        if j < 0 or j > h:
+            return False
+    return False
+
+
+def _graded_inside(head_post, k: int, lo: int, h: int) -> bool:
+    """MAP membership under the attachment arm's GRADED head belief: token `k` is inside the phrase when
+    P(k's head lies in the phrase already built, k+1..h) >= P(it lies outside).  `head_post` is the arm's
+    {1-based dep: {1-based head: P}}; with no posterior the caller's hard decision stands."""
+    if not head_post:
+        return True
+    row = head_post.get(k + 1) or head_post.get(str(k + 1)) or {}
+    if not row:
+        return True
+    p_in = 0.0
+    for j, p in row.items():
+        try:
+            j = int(j)
+        except (TypeError, ValueError):
+            continue
+        if lo + 1 <= j <= h + 1:
+            p_in += float(p)
+    return p_in >= 0.5
+
+
+def np_left_edge(toks, up, h: int, gov=None, head_post=None, mode=None) -> int:
+    """THE LEFT EDGE (0-based, inclusive) of the noun phrase headed by 0-based `h`."""
+    mode = RPN_BOUNDARY if mode is None else mode
+    a = h
+    for _ in range(_NP_LEFT_MAX):
+        k = a - 1
+        if k < 0:
+            break
+        okc = _np_cat_admissible(toks, up, k)
+        oka = (gov is None) or _arc_reaches(gov, k, h)
+        if mode == "cat":
+            ok = okc
+        elif mode == "arc":
+            ok = (gov is not None) and _arc_reaches(gov, k, h)
+        elif mode == "graded":
+            ok = okc and (oka or _graded_inside(head_post, k, k, h))
+        else:
+            ok = okc and oka
+        if not ok:
+            break
+        a = k
+        if _np_closes_left(toks, up, k):
+            break
+    return a
+
