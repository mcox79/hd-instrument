+        rpred = finiteness(toks, pos, j) if pos[j - 1] in ("VERB", "AUX") else ("cop" if j in cop else "")
+        d = 0.0
+        if rpred == "cop":
+            d += g_cop
+        if subordination(toks, pos, j) in ("sconj", "wh"):
+            d -= g_sub
+        if rpred in ("to", "ing"):
+            d -= g_fin
+        B[0][j] += d
+    return B
