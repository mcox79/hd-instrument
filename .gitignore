# Project
data/*
!data/.gitkeep
# DECISION 220 Tier-1 preservation sweep: load-bearing experimental measurements.
# Negation patterns must come BEFORE excludes that would re-exclude them.
!data/*/
!data/*/metrics.json
!data/*/results.json
!data/*/provenance.json
!data/*/verdict.json
!data/*/recent_verdicts.json
# Keep heavy artifacts excluded even within data/<exp>/ dirs:
data/*/model_weights.*
data/*/*.npy
data/*/*.pkl
data/*/cache/
data/*/__pycache__/
*.log

# MVP designs - gitignored until disclosure decision (see mvp/README.md)
mvp/

# Claude Code local config (user-specific, never commit)
.claude/settings.local.json

# Scratch / temp files generated by orchestrator sub-agents (root-level)
_append_log.py
_emit_outcomes.py
_queue_compliance_wedge.py
_stage_resonator_retry.py
_tmp_resonator.py
_cap_map_v*_append.md
_history_v*_append.md
_strategy_v*_append.md
_visibility_v*_append.md
_tmp_*.json

# Local CPU runner launchers (machine-specific paths, not portable)
cpu_runner_local_launcher.bat
cpu_runner_local_launcher_hidden.vbs

# Dashboard runtime state cache
tools/dashboard/.state/

# Generated metrics snapshot (root-only; data/*/metrics.json explicitly tracked per DECISION 220)
/metrics.json

