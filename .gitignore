# Project
data/*
!data/.gitkeep
# DECISION 220 Tier-1 preservation sweep: keep load-bearing experimental measurements.
# Pattern requires: (1) unignore subdirs so git traverses, (2) re-ignore their contents,
# (3) explicit allowlist for files we want tracked.
!data/*/
data/*/**
!data/*/metrics.json
!data/*/results.json
!data/*/provenance.json
!data/*/verdict.json
!data/*/recent_verdicts.json
# Dispatch consumer manifests (orchestrator autonomous remote-pull pattern)
!data/dispatch_requests/**/*.json
*.log

# MVP designs - gitignored until disclosure decision (see mvp/README.md)
mvp/

# Claude Code local config (user-specific, never commit)
.claude/settings.local.json

# Scratch / temp files generated by orchestrator sub-agents (root-level)
_append_log.py
_emit_outcomes.py
_queue_compliance_wedge.py
_stage_resonator_retry.py
_tmp_resonator.py
_cap_map_v*_append.md
_history_v*_append.md
_strategy_v*_append.md
_visibility_v*_append.md
_tmp_*.json

# Local CPU runner launchers (machine-specific paths, not portable)
cpu_runner_local_launcher.bat
cpu_runner_local_launcher_hidden.vbs

# Dashboard runtime state cache
tools/dashboard/.state/

# Generated metrics snapshot (root-only; data/*/metrics.json explicitly tracked per DECISION 220)
/metrics.json

# Prereqs typo directory (real pre-registrations live in preregs/)
prereqs/
testbed_data/

# Cloud credentials and ephemeral state (architecture v1 multi-session).
# Lambda Cloud API key + Anthropic API key MUST NEVER be committed.
.env.lambda
.env.cloud
.env.anthropic
.hf_token
data/cloud_cost_tracker.json
data/lambda_canary_report.json
data/session_heartbeat_*.json

.together_token

# v1 demo backend local env (api keys; NEVER commit)
.env.local
data/substrate_index/substrate_pos_tagger.npz

# remote-pull artifacts (re-pullable) -- purged from history 2026-06-18; never re-commit
data_remote_pull.tar
data_remote_pull_staging/
