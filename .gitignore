# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs
.venv/
venv/
ENV/
env/

# IDEs
.idea/
.vscode/
*.swp

# Testing / caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Project
data/*
!data/.gitkeep
# DECISION 220 Tier-1 preservation sweep: keep load-bearing experimental measurements.
# Pattern requires: (1) unignore subdirs so git traverses, (2) re-ignore their contents,
# (3) explicit allowlist for files we want tracked.
!data/*/
data/*/**
!data/*/metrics.json
!data/*/results.json
!data/*/provenance.json
!data/*/verdict.json
!data/*/recent_verdicts.json
# Dispatch consumer manifests (orchestrator autonomous remote-pull pattern)
!data/dispatch_requests/**/*.json
*.log

# MVP designs - gitignored until disclosure decision (see mvp/README.md)
mvp/

# Claude Code local config (user-specific, never commit)
.claude/settings.local.json

# Scratch / temp files generated by orchestrator sub-agents (root-level)
_append_log.py
_emit_outcomes.py
_queue_compliance_wedge.py
_stage_resonator_retry.py
_tmp_resonator.py
_cap_map_v*_append.md
_history_v*_append.md
_strategy_v*_append.md
_visibility_v*_append.md
_tmp_*.json

# Throwaway probes / one-off analysis scripts / temp output (see scratch/README.md).
# Cleared with: python tools/clear_scratch.py --yes
scratch/

# Local CPU runner launchers (machine-specific paths, not portable)
cpu_runner_local_launcher.bat
cpu_runner_local_launcher_hidden.vbs

# Dashboard runtime state cache
tools/dashboard/.state/

# Generated metrics snapshot (root-only; data/*/metrics.json explicitly tracked per DECISION 220)
/metrics.json

# Prereqs typo directory (real pre-registrations live in preregs/)
prereqs/
testbed_data/

# Cloud credentials and ephemeral state (architecture v1 multi-session).
# Lambda Cloud API key + Anthropic API key MUST NEVER be committed.
.env.lambda
.env.cloud
.env.anthropic
.hf_token
data/cloud_cost_tracker.json
data/lambda_canary_report.json
data/session_heartbeat_*.json

.together_token

# v1 demo backend local env (api keys; NEVER commit)
.env.local
data/substrate_index/substrate_pos_tagger.npz

# remote-pull artifacts (re-pullable) -- purged from history 2026-06-18; never re-commit
data_remote_pull.tar
data_remote_pull_staging/

# filter-branch leftover (accidentally committed during the 2026-06-19 history-rewrite; never re-commit)
.git-rewrite/
data/substrate_repl_cache/*.pkl

# Director-KB continuous-ingest atomic-swap staging dirs (transient; auto-cleaned)
data/substrate_director_kb_*.staging.*
data/substrate_director_kb_*.old.*
data/director_kb_continuous.lock
data/director_kb_continuous.log

# dashboard supervisor singleton runtime pid-file (testbed 2026-07-04)
tools/dashboard/supervisor.pid

# large foundation data artifact (258MB) — keep local, out of git
data/cskg_foundation_v1/
data/exp_cskg_foundation_v1/

# Retired 2026-08-12: hd_session_watchdog pinged a dead multi-session fleet and emitted
# 27k files into notes/, polluting the director_kb index. Source disabled in
# tools/hd_session_watchdog.py; this guards against regeneration if the task is revived.
notes/watchdog_ping_*
archive/watchdog_pings/

# Repo-hygiene reclaim sweep (2026-08-13): uncited large artifacts moved out of data/,
# never deleted. Keep out of git -- these are multi-GB binaries, not source.
archive/reclaimed_2026-08-13/

# Literature source cache (2026-08-13). Track the index and the README: they are the
# authoritative record and are small text. Do NOT track files/ -- stored PDFs are binaries,
# they are reproducible from doi_or_url, and index.jsonl carries their sha256.
!data/literature_cache/README.md
!data/literature_cache/index.jsonl
data/literature_cache/files/**
