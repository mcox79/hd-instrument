# Lambda Cloud API credentials (architecture v1 multi-session).
# Copy this file to .env.lambda and replace the placeholder with your real key.
# .env.lambda is in .gitignore -- it must never be committed.
#
# Get your API key from: https://cloud.lambdalabs.com/api-keys
#
# Used by:
#   tools/cloud/smoke_connection.py   (zero-spend connectivity check)
#   tools/cloud/canary_lifecycle.py   (launch + smoke + terminate; ~$0.15 spend)

LAMBDA_CLOUD_API_KEY=secret_REPLACE_ME_xxxxxxxxxxxxxxxxxxxxxxxx
