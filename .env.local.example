# v1 demo API keys + config (LOCAL DEV; never commit; in .gitignore)
#
# To use:
#   1. Copy this file to .env.local (in same directory)
#   2. Paste your real keys after the `=` (no quotes, no spaces)
#   3. Restart the backend (uvicorn picks up env on boot)
#
# Get the keys here:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional overrides (defaults are fine)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
SUBSTRATE_DIM=8192
HD_BACKEND_HOST=127.0.0.1
HD_BACKEND_PORT=8000

# Demo mode behavior
DEMO_MODE_AUTO_PAUSE_ON_QUERY=false
