{"text": "He was horrified at his thoughtlessness and tried to comfort her.", "args": [{"head": "he", "role": "EXPERIENCER"}, {"head": "thoughtlessness", "role": "STIMULUS"}], "verb_lemma": "horrify", "exp_type": "obj", "construction": "exp_obj_passive", "source": "litbank:345_dracula", "split_recommendation": "heldout"}
{"text": "For a few minutes we stood horrified over the corpse of Foulata.", "args": [{"head": "we", "role": "EXPERIENCER"}, {"head": "corpse", "role": "STIMULUS"}], "verb_lemma": "horrify", "exp_type": "obj", "construction": "exp_obj_passive", "source": "litbank:2166_king_solomons_mines", "split_recommendation": "heldout"}
{"text": "A sudden noise startled her from her reverie.", "args": [{"head": "noise", "role": "STIMULUS"}, {"head": "her", "role": "EXPERIENCER"}], "verb_lemma": "startle", "exp_type": "obj", "construction": "exp_obj_active", "source": "supplement", "split_recommendation": "train"}
{"text": "It would comfort me, my husband!", "args": [{"head": "it", "role": "STIMULUS"}, {"head": "me", "role": "EXPERIENCER"}], "verb_lemma": "comfort", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:345_dracula", "split_recommendation": "train"}
