{"text": "Philip was interested in her shiftless life.", "args": [{"head": "philip", "role": "EXPERIENCER"}, {"head": "life", "role": "STIMULUS"}], "verb_lemma": "interest", "exp_type": "obj", "construction": "exp_obj_passive", "source": "litbank:351_of_human_bondage", "split_recommendation": "train"}
{"text": "Thea was grateful for his silent sympathy, even while it irritated her.", "args": [{"head": "it", "role": "STIMULUS"}, {"head": "her", "role": "EXPERIENCER"}], "verb_lemma": "irritate", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:44_the_song_of_the_lark", "split_recommendation": "train"}
