{"text": "All the indignities of his life enraged him.", "args": [{"head": "indignities", "role": "STIMULUS"}, {"head": "him", "role": "EXPERIENCER"}], "verb_lemma": "enrage", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:2814_dubliners", "split_recommendation": "train"}
{"text": "He was enraged against the tattered man, and could have strangled him.", "args": [{"head": "he", "role": "EXPERIENCER"}, {"head": "man", "role": "STIMULUS"}], "verb_lemma": "enrage", "exp_type": "obj", "construction": "exp_obj_passive", "source": "litbank:73_the_red_badge_of_courage_an_episode_of_the_american_civil_war", "split_recommendation": "train"}
