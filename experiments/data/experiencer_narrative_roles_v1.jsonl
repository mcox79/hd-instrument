{"text": "The delay vexed him more than he cared to say.", "args": [{"head": "delay", "role": "STIMULUS"}, {"head": "him", "role": "EXPERIENCER"}], "verb_lemma": "vex", "exp_type": "obj", "construction": "exp_obj_active", "source": "supplement", "split_recommendation": "train"}
{"text": "Bagnet, quite charmed, hopes to see him again.", "args": [{"head": "bagnet", "role": "EXPERIENCER"}], "verb_lemma": "charm", "exp_type": "obj", "construction": "exp_obj_passive", "source": "litbank:1023_bleak_house", "split_recommendation": "train"}
{"text": "The monstrosity of the man had fascinated her.", "args": [{"head": "monstrosity", "role": "STIMULUS"}, {"head": "her", "role": "EXPERIENCER"}], "verb_lemma": "fascinate", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:974_the_secret_agent_a_simple_tale", "split_recommendation": "train"}
