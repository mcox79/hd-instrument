{"text": "Nothing could console and nothing could appease her.", "args": [{"head": "nothing", "role": "STIMULUS"}, {"head": "her", "role": "EXPERIENCER"}], "verb_lemma": "console", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:1342_pride_and_prejudice", "split_recommendation": "train"}
{"text": "Those thoughts began a little to disturb his brain.", "args": [{"head": "thoughts", "role": "STIMULUS"}, {"head": "brain", "role": "EXPERIENCER"}], "verb_lemma": "disturb", "exp_type": "obj", "construction": "exp_obj_active", "source": "litbank:6593_history_of_tom_jones_a_foundling", "split_recommendation": "train"}
